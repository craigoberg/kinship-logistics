# Yada Connect — copy to .env and fill in values from Supabase Dashboard.
# Project Settings → API: publishable key + service_role secret (different keys).

# Client (safe to expose in browser bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- DEV / QA UI flags (NOT secrets — baked into the client JS) ---
# Lane: dev | test | prod (BL-099). Tools show on dev/test.
VITE_APP_LANE=dev
# Force-show SIM clock / Reset day / Simulate offline (optional; Lovable DEV already on).
# VITE_SHOW_TEST_TOOLS=true
# Future PROD only — hides all test tools even on Lovable:
# VITE_IS_PRODUCTION=true


# Server handlers (createServerFn, internal routes)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — Admin restore truncate. NEVER prefix with VITE_.
# NEVER commit the real value. Store in host secrets for production.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
